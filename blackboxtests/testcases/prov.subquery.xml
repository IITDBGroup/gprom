<entry key="q4.query">
PROVENANCE OF (
    WITH x AS (SELECT sum(a) AS sa, b AS xb FROM r GROUP BY b)

    SELECT *
    FROM r, x
    WHERE sa = (SELECT max(sa) FROM x)
);
</entry>
