ARG UBUNTU_BASE=ubuntu:22.04
FROM ${UBUNTU_BASE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|archive.ubuntu.com|mirrors.aliyun.com|g; s|security.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    build-essential \
    bison \
    flex \
    libpq-dev \
    libreadline-dev \
    libtool \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY . /gprom
WORKDIR /gprom

RUN test -x ./autogen.sh && ./autogen.sh || true
RUN ./configure --disable-java --enable-postgres \
    --with-libpq-headers=/usr/include/postgresql
RUN make -j"$(nproc)"

ARG UBUNTU_BASE=ubuntu:22.04
FROM ${UBUNTU_BASE}

ARG DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|archive.ubuntu.com|mirrors.aliyun.com|g; s|security.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    postgresql-client \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /gprom/src/command_line/gprom /usr/local/bin/gprom
COPY test /gprom/test
COPY flights_rset.sql hospital_outlier_rset.sql sales_rset.csv /gprom/
COPY docker/uset-test/run-tests.sh /usr/local/bin/run-tests.sh
COPY docker/uset-test/gprom-shell.sh /usr/local/bin/gprom-shell

RUN chmod +x /usr/local/bin/run-tests.sh /usr/local/bin/gprom-shell

WORKDIR /gprom
ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
